# Copy to .env and edit. .env is git-ignored and must never contain live secrets
# that are not needed locally.
#
# Mode: "demo" (default, offline, synthetic data) or "live".
# Live mode additionally requires approved source-policy records in the database;
# setting this alone does not enable any connector.
DESK_MODE=demo

# Database paths. Demo and live data are kept in separate files on purpose.
DESK_DEMO_DB=data/demo.sqlite
DESK_LIVE_DB=data/live.sqlite

# Display time zone (IANA name). Stored timestamps are always UTC.
DESK_TIMEZONE=Europe/Prague

# Master network switch. Even when this is true, every request must still pass
# the source-policy service (approved host, scope, limits, non-expired review).
DESK_ALLOW_NETWORK=false

# Runtime AI adapter. Off by default. Enabling it requires a reviewed decision
# that the relevant business data may be sent to the provider, plus a spend cap.
DESK_AI_ENABLED=false
DESK_AI_PROVIDER=
DESK_AI_MODEL=
DESK_AI_API_KEY=
DESK_AI_MONTHLY_SPEND_CAP_EUR=0

# Optional connector credentials. Absent credentials must fail closed, never
# fall back to scraping a public page.
DESK_ARES_CONTACT_EMAIL=
DESK_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
DESK_USER_AGENT=luxury-car-opportunity-desk/0.1 (local research prototype)

# Freshness thresholds (hours / days). Product assumptions, not legal standards.
DESK_SUPPLY_STALE_HOURS=24
DESK_COMPARABLE_STALE_DAYS=14
DESK_BRIEF_STALE_DAYS=30
DESK_CONTACT_STALE_DAYS=90
